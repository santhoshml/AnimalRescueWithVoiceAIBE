PORT=3001

LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-max

# Optional Minimax voice output (if your LiveKit inference environment supports minimax/* TTS models)
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_TTS_MODEL=minimax/speech-02-hd

UNSILOED_API_KEY=your_unsiloed_api_key
UNSILOED_BASE_URL=https://api.unsiloed.ai

# Moss persistence (primary)
MOSS_PROJECT_ID=your_moss_project_id
MOSS_PROJECT_KEY=your_moss_project_key
MOSS_INDEX_NAME=wildlife-cases
MOSS_KB_INDEX_NAME=wildlife-kb

# Optional legacy fallback (not required when using Moss)
AWS_REGION=us-west-1
DYNAMODB_TABLE=AnimalRescueCases
